# =========================================================================
# vidplatform — environment variables
# Copy to `.env` and fill in the secrets. Loaded by:
#   - apps/api/app/settings.py        (FastAPI)
#   - apps/worker/worker/celery_app.py (Celery)
#   - apps/modal_app/app.py           (Modal — also via `modal secret create`)
# =========================================================================

# ── LLM (Google AI Studio) ─────────────────────────────────────────────
# Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_PROJECT_NAME=


# ── Sarvam (Translate + Bulbul-v2 multilingual TTS) ────────────────────
# Get a key at https://www.sarvam.ai/
SARVAM_API_KEY=
SARVAM_TTS_MODEL=bulbul:v2
SARVAM_TRANSLATE_MODEL=sarvam-translate:v1

# ── Modal (GPU serverless workers) ─────────────────────────────────────
# `modal token new` writes these to ~/.modal.toml; mirror them here for
# anywhere that doesn't use the CLI.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
MODAL_APP_NAME=vidplatform
# Stubs are ON by default (no GPU spend). Set to 0 only for production Modal runs.
MODAL_STUB=1

# ── Database ───────────────────────────────────────────────────────────
# Local dev (matches infra/docker-compose.dev.yml — Postgres 16):
DATABASE_URL=postgresql+asyncpg://vidplatform:dev@localhost:5432/vidplatform
# The Celery worker uses sync psycopg3; api/db.py auto-converts the URL.

# ── Object storage (AWS S3) ─────────────────────────────────────────────
# Create the bucket first: aws s3 mb s3://your-bucket --region us-east-1
S3_BUCKET=vidplatform
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Redis (Celery broker + SSE pub/sub) ────────────────────────────────
# Local: docker-compose redis.
# Production: Upstash → rediss://default:<token>@<endpoint>:<port>
REDIS_URL=redis://localhost:6379/0

# ── API service ────────────────────────────────────────────────────────
API_BASE_URL=http://localhost:8000
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000"]

# ── Frontend ───────────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ── Music provider (acestep | magenta) ─────────────────────────────────
MUSIC_PROVIDER=acestep
ACESTEP_MODEL_REVISION=main

# ── Cost cap (USD against the Modal credit) ────────────────────────────
MODAL_GLOBAL_COST_CAP_USD=25
MODAL_PER_PROJECT_COST_CAP_USD=1.5

# ── Oracle Cloud Infrastructure (OCI) — Always Free deployment ─────────
# The API service + Celery worker run as two systemd units on a single
# Ampere A1 (4 OCPU / 24 GB) VM in OCI Always-Free. Postgres + Redis can
# run alongside, or use OCI Autonomous DB (free) + Upstash Redis.
OCI_REGION=ap-mumbai-1
OCI_COMPARTMENT_OCID=
OCI_VM_PUBLIC_IP=
OCI_SSH_USER=ubuntu
# Path to the SSH private key used by deploy scripts in infra/oracle/.
OCI_SSH_KEY_PATH=~/.ssh/oci_vidplatform
